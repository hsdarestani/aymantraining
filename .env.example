DATABASE_URL=postgresql://bedifferent:change-me@db:5432/bedifferent?schema=public
CRON_SECRET=generate-a-random-secret
DATA_DIR=/app/data
BACKUP_DIR=/opt/bedifferent/backups
NEXT_PUBLIC_APP_URL=https://bedifferent.smarbiz.sbs

# Direct native push. Base64 encode the Firebase service-account JSON.
FIREBASE_SERVICE_ACCOUNT_B64=
# Alternative Firebase Admin fields
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Direct Apple StoreKit / App Store Server API
APPLE_BUNDLE_ID=com.smarbiz.bedifferent
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_PRIVATE_KEY_B64=

# Direct Google Play Billing verification
GOOGLE_PLAY_PACKAGE_NAME=com.smarbiz.bedifferent
GOOGLE_PLAY_SERVICE_ACCOUNT_B64=
GOOGLE_RTDN_WEBHOOK_SECRET=

# Store product IDs
STORE_PRODUCT_PRO_MONTHLY=bd_pro_monthly
STORE_PRODUCT_PRO_YEARLY=bd_pro_yearly

# Strato SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Optional analytics / error reporting
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
SENTRY_DSN=
