generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriptionTier {
  FREE
  PRO
  ELITE
}

enum UserRole {
  ATHLETE
  COACH
  ADMIN
}

enum MessageKind {
  TEXT
  VOICE
  VIDEO
}

enum MediaKind {
  PROGRESS_PHOTO
  TECHNIQUE_VIDEO
  TEST_VIDEO
  VOICE_MESSAGE
  EXERCISE_IMAGE
  EXERCISE_VIDEO
}

model User {
  reviewedPathwayTests JourneyTestAttempt[] @relation("PathwayTestReviewer")
  cyclePreferences CyclePrivacy?
  journeyIntake JourneyIntake?
  dashboardPreference AthleteDashboardPreference?
  pathwayEnrollments JourneyEnrollment[]
  id                  String           @id @default(cuid())
  email               String           @unique
  passwordHash        String
  name                String?
  birthDate           DateTime?
  sex                 String?
  heightCm            Float?
  trainingExperience  String?
  availabilityPerWeek Int?
  timezone            String           @default("Europe/Berlin")
  locale              String           @default("de")
  role                UserRole         @default(ATHLETE)
  subscriptionTier    SubscriptionTier @default(FREE)
  onboardingCompleted Boolean          @default(false)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  goals               Goal[]
  workouts            Workout[]
  scoreSnapshots      ScoreSnapshot[]
  dailyChecks         DailyCheck[]
  sessions            AuthSession[]
  consents            ConsentRecord[]
  assignments         PlanAssignment[]
  pushPreferences     PushPreference[]
  deviceTokens        DeviceToken[]
  coachAssignments     CoachAssignment[] @relation("AthleteCoach")
  coachedAthletes      CoachAssignment[] @relation("CoachAthlete")
  athleteContext       AthleteContext?
  wearableConnections WearableConnection[]
  eventRegistrations  EventRegistration[]
  aiMessages           AiMessage[]
  aiHandoffs           AiHandoff[]
  wearableAuthAttempts WearableAuthAttempt[]
  coachBriefs          CoachBrief[] @relation("CoachBriefAuthor")
}

model AuthSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuthThrottle {
  id          String   @id @default(cuid())
  identifier  String
  windowStart DateTime
  attempts    Int      @default(0)
  blockedUntil DateTime?
  updatedAt   DateTime @updatedAt

  @@unique([identifier, windowStart])
}

model ConsentRecord {
  id        String   @id @default(cuid())
  userId    String
  type      String
  version   String
  granted   Boolean
  grantedAt DateTime @default(now())
  ipHash    String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model Goal {
  id        String   @id @default(cuid())
  userId    String
  type      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TrainingPlan {
  chapterItems JourneyChapterItem[]
  id          String             @id @default(cuid())
  name        String
  description String?
  isTemplate  Boolean            @default(true)
  active      Boolean            @default(true)
  proOnly     Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  workouts    Workout[]
  items       TrainingPlanItem[]
  assignments PlanAssignment[]
}

model TrainingPlanItem {
  id           String       @id @default(cuid())
  planId       String
  exerciseId   String
  dayIndex     Int          @default(0)
  orderIndex   Int
  targetSets   Int          @default(3)
  targetReps   String?
  targetRpe    Int?
  restSeconds  Int          @default(90)
  notes        String?
  progressionRule Json?
  plan         TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  exercise     Exercise     @relation(fields: [exerciseId], references: [id])

  @@index([planId, dayIndex, orderIndex])
}

model PlanAssignment {
  id        String       @id @default(cuid())
  userId    String
  planId    String
  active    Boolean      @default(true)
  startsAt  DateTime     @default(now())
  endsAt    DateTime?
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      TrainingPlan @relation(fields: [planId], references: [id])

  @@index([userId, active])
}

model Workout {
  id             String            @id @default(cuid())
  userId         String
  trainingPlanId String?
  title          String
  scheduledAt    DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  rpe            Int?
  notes          String?
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainingPlan   TrainingPlan?     @relation(fields: [trainingPlanId], references: [id])
  sets           SetLog[]
  exercises      WorkoutExercise[]

  @@index([userId, scheduledAt])
}

model WorkoutExercise {
  id          String   @id @default(cuid())
  workoutId   String
  exerciseId  String
  orderIndex  Int
  targetSets  Int      @default(3)
  targetReps  String?
  targetRpe   Int?
  restSeconds Int      @default(90)
  notes       String?
  workout     Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise    Exercise @relation(fields: [exerciseId], references: [id])

  @@unique([workoutId, orderIndex])
}

model Exercise {
  chapterItems JourneyChapterItem[]
  id               String             @id
  nameDe           String
  nameEn           String?
  category         String
  equipment        String?
  primaryMuscles   String?
  secondaryMuscles String?
  level            Int                @default(1)
  coachCue1        String?
  coachCue2        String?
  coachCue3        String?
  commonMistakes   Json?
  easierExerciseId String?
  harderExerciseId String?
  videoUrl         String?
  imageStart       String?
  imageMiddle      String?
  imageEnd         String?
  trackingType     String?
  freeAccess       Boolean            @default(false)
  tags             String[]           @default([])
  active           Boolean            @default(true)
  sets             SetLog[]
  planItems        TrainingPlanItem[]
  workoutExercises WorkoutExercise[]
}

model SetLog {
  id         String   @id @default(cuid())
  workoutId  String
  exerciseId String
  setNumber  Int
  reps       Int?
  weightKg   Float?
  durationS  Int?
  distanceM  Float?
  rpe        Int?
  completedAt DateTime @default(now())
  workout    Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise   Exercise @relation(fields: [exerciseId], references: [id])

  @@unique([workoutId, exerciseId, setNumber])
}

model DailyCheck {
  id         String   @id @default(cuid())
  userId     String
  date       DateTime @db.Date
  energy     Int?
  soreness   Int?
  mood       Int?
  stress     Int?
  sleepHours Float?
  restingHr  Float?
  hrv        Float?
  steps      Int?
  waterMl    Int?
  proteinG   Float?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model BodyMetric {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date
  weightKg  Float?
  waistCm   Float?
  chestCm   Float?
  bodyFat   Float?
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model WearableDaily {
  id             String   @id @default(cuid())
  userId         String
  date           DateTime @db.Date
  source         String
  steps          Int?
  activeCalories Float?
  totalCalories  Float?
  restingHr      Float?
  hrv            Float?
  sleepMinutes   Int?
  sleepStages    Json?
  vo2max         Float?
  workouts       Json?
  weightKg       Float?
  completeness   Int      @default(0)
  createdAt      DateTime @default(now())

  @@unique([userId, date, source])
  @@index([userId, date])
}

model NutritionDaily {
  id                String   @id @default(cuid())
  userId            String
  date              DateTime @db.Date
  calories          Float?
  proteinG          Float?
  carbsG            Float?
  fatG              Float?
  waterMl           Int?
  fruitVegServings  Float?
  addedSugarG       Float?
  processedFoodScore Int?
  source            String?
  fuelScore         Int?

  @@unique([userId, date])
}

model PerformanceTest {
  id          String       @id @default(cuid())
  userId      String
  name        String
  scheduledAt DateTime?
  completedAt DateTime?
  notes       String?
  definition  Json?
  createdAt   DateTime     @default(now())
  results     TestResult[]

  @@index([userId, completedAt])
}

model TestResult {
  id        String          @id @default(cuid())
  testId    String
  metric    String
  value     Float
  unit      String
  videoUrl  String?
  createdAt DateTime        @default(now())
  test      PerformanceTest @relation(fields: [testId], references: [id], onDelete: Cascade)
}

model ScoreSnapshot {
  id           String   @id @default(cuid())
  userId       String
  date         DateTime @db.Date
  total        Int
  strength     Int?
  endurance    Int?
  athleticism  Int?
  mobility     Int?
  recovery     Int?
  fuel         Int?
  consistency  Int?
  completeness Int      @default(0)
  explanation  Json?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model CoachingRule {
  id         String   @id @default(cuid())
  key        String   @unique
  title      String
  enabled    Boolean  @default(true)
  priority   Int      @default(100)
  conditions Json
  action     Json
  updatedAt  DateTime @updatedAt
}

model Recommendation {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime @db.Date
  severity    String
  title       String
  explanation String
  action      String
  sourceRule  String?
  coachStatus String   @default("PENDING")
  createdAt   DateTime @default(now())

  @@index([userId, date])
}

model Message {
  id          String      @id @default(cuid())
  athleteId   String
  coachId     String
  senderId    String
  kind        MessageKind @default(TEXT)
  text        String?
  mediaId     String?
  durationSec Int?
  createdAt   DateTime    @default(now())
  readAt      DateTime?

  @@index([athleteId, createdAt])
}

model VideoFeedback {
  id          String   @id @default(cuid())
  athleteId   String
  coachId     String
  mediaId     String
  annotations Json?
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
  reviewedAt  DateTime?

  @@index([athleteId, createdAt])
}

model MediaAsset {
  chapterMediaVariants ChapterMediaVariant[]
  id            String    @id @default(cuid())
  ownerId       String
  relatedUserId String?
  kind          MediaKind
  storageKey    String    @unique
  originalName  String
  mimeType      String
  sizeBytes     Int
  createdAt     DateTime  @default(now())

  @@index([ownerId, createdAt])
  @@index([relatedUserId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  category  String
  title     String
  body      String
  data      Json?
  sendAt    DateTime?
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([sendAt, sentAt])
}

model PushPreference {
  id        String @id @default(cuid())
  userId    String
  category  String
  enabled   Boolean @default(true)
  quietFrom String?
  quietTo   String?
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
}

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  platform  String
  token     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active])
}

model Subscription {
  id          String           @id @default(cuid())
  userId      String
  tier        SubscriptionTier
  provider    String
  externalId  String?
  status      String
  trialEndsAt DateTime?
  renewsAt    DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([userId, status])
  @@unique([provider, externalId])
}

model Badge {
  id         String   @id @default(cuid())
  userId     String
  key        String
  name       String
  unlockedAt DateTime @default(now())

  @@unique([userId, key])
}

model Challenge {
  id          String   @id @default(cuid())
  title       String
  description String?
  proOnly     Boolean  @default(false)
  startsAt    DateTime
  endsAt      DateTime
  createdAt   DateTime @default(now())
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model FeatureFlag {
  key       String @id
  free      Boolean @default(false)
  pro       Boolean @default(true)
  elite     Boolean @default(true)
  updatedAt DateTime @updatedAt
}

model ReferenceNorm {
  id        String   @id @default(cuid())
  metric    String
  sex       String?
  minAge    Int?
  maxAge    Int?
  minWeight Float?
  maxWeight Float?
  lowValue  Float
  highValue Float
  higherIsBetter Boolean @default(true)
  updatedAt DateTime @updatedAt

  @@index([metric])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String?
  name      String
  properties Json?
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([userId, createdAt])
}


model WeeklyCheckIn {
  id           String   @id @default(cuid())
  userId       String
  weekStart    DateTime @db.Date
  weightKg     Float?
  energy       Int?
  recovery     Int?
  training     Int?
  note         String?
  questions    String?
  photoMediaId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, weekStart])
  @@index([userId, createdAt])
}

model ChallengeEntry {
  id          String   @id @default(cuid())
  challengeId String
  userId      String
  progress    Float    @default(0)
  completedAt DateTime?
  joinedAt    DateTime @default(now())

  @@unique([challengeId, userId])
  @@index([userId, joinedAt])
}

model Referral {
  id             String   @id @default(cuid())
  referrerUserId String
  referredUserId String?  @unique
  code           String   @unique
  status         String   @default("OPEN")
  rewardGrantedAt DateTime?
  createdAt      DateTime @default(now())

  @@index([referrerUserId, createdAt])
}


model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}


model WaitlistEntry {
  id        String   @id @default(cuid())
  userId    String   @unique
  status    String   @default("WAITING")
  joinedAt  DateTime @default(now())
  invitedAt DateTime?
  notes     String?

  @@index([status, joinedAt])
}


model CoachAssignment {
  id        String   @id @default(cuid())
  athleteId String
  coachId   String
  active    Boolean  @default(true)
  startsAt  DateTime @default(now())
  endsAt    DateTime?
  createdAt DateTime @default(now())
  athlete   User     @relation("AthleteCoach", fields: [athleteId], references: [id], onDelete: Cascade)
  coach     User     @relation("CoachAthlete", fields: [coachId], references: [id], onDelete: Cascade)

  @@index([athleteId, active])
  @@index([coachId, active])
}

model AthleteContext {
  id                    String   @id @default(cuid())
  userId                String   @unique
  nextMatchAt           DateTime?
  travelModeUntil       DateTime?
  cycleTrackingEnabled  Boolean  @default(false)
  cycleStartDate        DateTime?
  cycleLengthDays       Int      @default(28)
  targetScore           Int?
  targetDate            DateTime?
  bedtimeTarget         String?
  stepTarget            Int      @default(10000)
  waterTargetMl         Int      @default(2500)
  proteinTargetG        Float    @default(130)
  preferredMorningHour  Int      @default(8)
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WearableConnection {
  id             String   @id @default(cuid())
  userId         String
  provider       String
  externalUserId String?
  status         String   @default("CONNECTED")
  metadata       Json?
  connectedAt    DateTime @default(now())
  lastSyncAt     DateTime?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([provider, externalUserId])
}

model CoachBrief {
  id           String           @id @default(cuid())
  coachId      String
  title        String
  body         String?
  mediaId      String?
  audienceTier SubscriptionTier @default(PRO)
  publishAt    DateTime         @default(now())
  expiresAt    DateTime?
  createdAt    DateTime         @default(now())
  coach        User             @relation("CoachBriefAuthor", fields: [coachId], references: [id], onDelete: Cascade)

  @@index([publishAt])
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  type        String   @default("MEETUP")
  startsAt    DateTime
  endsAt      DateTime?
  location    String?
  meetingUrl  String?
  capacity    Int?
  minTier     String   @default("FREE")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  registrations EventRegistration[]

  @@index([startsAt, active])
}

model EventRegistration {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  status    String   @default("REGISTERED")
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId, createdAt])
}

model AiMessage {
  id              String   @id @default(cuid())
  userId          String
  role            String
  content         String
  sourceContext   Json?
  coachReviewedAt DateTime?
  coachId         String?
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}


model CompanionPairCode {
  id        String   @id @default(cuid())
  userId    String
  codeHash  String   @unique
  expiresAt DateTime
  claimedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model WearableAuthAttempt {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  provider String
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, provider])
}

model AiHandoff {
  id String @id @default(cuid())
  userId String
  coachId String?
  reason String
  summary String
  status String @default("OPEN")
  resolution String?
  createdAt DateTime @default(now())
  resolvedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, status])
  @@index([coachId, status])
}


// BE DIFFERENT development journey v2.
// Additive to legacy Goal, TrainingPlan, PerformanceTest, ScoreSnapshot and Badge.
// No automatic migration from score-derived NORMAL/other levels into earned levels.
enum JourneyLevel {
  READY
  AWAKE
  DIFFERENT
  BE_DIFFERENT
  TRULY_DIFFERENT
}

enum PathwayVersionState {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PathwayEnrollmentState {
  PENDING
  ACTIVE
  PAUSED
  FINISHED
}

enum JourneyAssessmentKind {
  PLACEMENT
  CHAPTER_FINAL
}

enum JourneyVerdict {
  PENDING
  PASSED
  FAILED
}

enum JourneyUnlockReason {
  PLACEMENT_TEST
  COACH_APPROVAL
  PASSED_CHAPTER_TEST
  LEGACY_REVIEW
}

enum ChapterItemKind {
  EXERCISE
  TRAINING_PLAN
  GUIDANCE
}

// A reusable goal catalog. The existing per-user Goal table remains untouched.
model JourneyGoal {
  id          String @id @default(cuid())
  slug        String @unique
  titleDe     String
  description String?
  active      Boolean @default(true)
  createdAt   DateTime @default(now())
  pathways    JourneyPathwayGoal[]
}

model JourneyPathway {
  id          String @id @default(cuid())
  slug        String @unique
  titleDe     String
  description String?
  active      Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  goals       JourneyPathwayGoal[]
  versions    JourneyPathwayVersion[]
}

model JourneyPathwayGoal {
  pathwayId String
  goalId    String
  pathway   JourneyPathway @relation(fields:[pathwayId],references:[id],onDelete:Cascade)
  goal      JourneyGoal @relation(fields:[goalId],references:[id],onDelete:Restrict)

  @@id([pathwayId,goalId])
  @@index([goalId])
}

// Published versions must be immutable; edit by cloning a new DRAFT version.
model JourneyPathwayVersion {
  id          String @id @default(cuid())
  pathwayId   String
  version     Int
  goalSlugs   String[] @default([]) // Frozen selection for this version, not mutable pathway links
  state       PathwayVersionState @default(DRAFT)
  notes       String?
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  pathway     JourneyPathway @relation(fields:[pathwayId],references:[id],onDelete:Restrict)
  levels      JourneyLevelDefinition[]
  assessments JourneyAssessment[]
  enrollments JourneyEnrollment[]

  @@unique([pathwayId,version])
  @@index([state,publishedAt])
}

model JourneyLevelDefinition {
  id          String @id @default(cuid())
  versionId   String
  code        JourneyLevel
  labelDe     String
  description String?
  position    Int
  version     JourneyPathwayVersion @relation(fields:[versionId],references:[id],onDelete:Restrict)
  chapters    JourneyChapter[]
  awards      JourneyLevelAward[]

  @@unique([versionId,code])
  @@unique([versionId,position])
}

model JourneyChapter {
  id                 String @id @default(cuid())
  levelId            String
  position           Int
  titleDe            String
  description        String?
  plannedDurationDays Int?
  level              JourneyLevelDefinition @relation(fields:[levelId],references:[id],onDelete:Restrict)
  items              JourneyChapterItem[]
  assessments        JourneyAssessment[]
  unlocks            JourneyChapterUnlock[]
  completions        JourneyChapterCompletion[]

  @@unique([levelId,position])
}

model JourneyChapterItem {
  id             String @id @default(cuid())
  chapterId      String
  position       Int
  kind           ChapterItemKind
  titleDe        String?
  description    String?
  exerciseId     String?
  trainingPlanId String?
  mandatory      Boolean @default(true)
  publishedSnapshot Json? // Immutable reference data captured on publishing
  chapter        JourneyChapter @relation(fields:[chapterId],references:[id],onDelete:Restrict)
  exercise       Exercise? @relation(fields:[exerciseId],references:[id],onDelete:Restrict)
  trainingPlan   TrainingPlan? @relation(fields:[trainingPlanId],references:[id],onDelete:Restrict)
  media          ChapterMediaVariant[]
  completions    JourneyActivityCompletion[]

  @@unique([chapterId,position])
  @@index([exerciseId])
  @@index([trainingPlanId])
}

// Media references do not imply public access. Streaming must check both tier
// AND earned chapter access in Step 8 before serving the bytes.
model ChapterMediaVariant {
  id          String @id @default(cuid())
  itemId      String
  mediaAssetId String
  role        String // START_IMAGE, MIDDLE_IMAGE, END_IMAGE, EXPLANATION_VIDEO
  presenter   String @default("COACH") // COACH, TRAINER, etc.
  minTier     SubscriptionTier @default(FREE)
  durationSec Int?
  item        JourneyChapterItem @relation(fields:[itemId],references:[id],onDelete:Restrict)
  media       MediaAsset @relation(fields:[mediaAssetId],references:[id],onDelete:Restrict)

  @@unique([itemId,role,presenter])
  @@index([mediaAssetId])
}

// Every placement/chapter test belongs to one frozen curriculum version.
// Criteria are authored by the coach and must be explicitly approved.
model JourneyAssessment {
  id          String @id @default(cuid())
  versionId   String
  chapterId   String?
  kind        JourneyAssessmentKind
  titleDe     String
  criteria    Json
  retestRules Json?
  approvedAt  DateTime?
  createdAt   DateTime @default(now())
  version     JourneyPathwayVersion @relation(fields:[versionId],references:[id],onDelete:Restrict)
  chapter     JourneyChapter? @relation(fields:[chapterId],references:[id],onDelete:Restrict)
  attempts    JourneyTestAttempt[]

  @@index([versionId,kind])
  @@index([chapterId,kind])
}

model JourneyEnrollment {
  id              String @id @default(cuid())
  userId          String
  versionId       String
  state           PathwayEnrollmentState @default(PENDING)
  selfLevel       JourneyLevel?
  confirmedLevel  JourneyLevel?
  confirmedAt     DateTime?
  startedAt       DateTime @default(now())
  endedAt         DateTime?
  user            User @relation(fields:[userId],references:[id],onDelete:Restrict)
  version         JourneyPathwayVersion @relation(fields:[versionId],references:[id],onDelete:Restrict)
  attempts        JourneyTestAttempt[]
  unlocks         JourneyChapterUnlock[]
  completions     JourneyChapterCompletion[]
  activities      JourneyActivityCompletion[]
  awards          JourneyLevelAward[]

  @@unique([userId,versionId])
  @@index([userId,state])
}

model JourneyActivityCompletion {
  id            String @id @default(cuid())
  enrollmentId  String
  itemId        String
  completedAt   DateTime @default(now())
  enrollment    JourneyEnrollment @relation(fields:[enrollmentId],references:[id],onDelete:Restrict)
  item          JourneyChapterItem @relation(fields:[itemId],references:[id],onDelete:Restrict)

  @@unique([enrollmentId,itemId])
  @@index([itemId])
}

model JourneyTestAttempt {
  id              String @id @default(cuid())
  enrollmentId    String
  assessmentId    String
  idempotencyKey  String
  results         Json
  verdict         JourneyVerdict @default(PENDING)
  feedback        Json?
  reviewedById    String?
  reviewedAt      DateTime?
  submittedAt     DateTime @default(now())
  enrollment      JourneyEnrollment @relation(fields:[enrollmentId],references:[id],onDelete:Restrict)
  assessment      JourneyAssessment @relation(fields:[assessmentId],references:[id],onDelete:Restrict)
  reviewedBy      User? @relation("PathwayTestReviewer",fields:[reviewedById],references:[id],onDelete:SetNull)
  unlocks         JourneyChapterUnlock[]
  completions     JourneyChapterCompletion[]
  levelAwards     JourneyLevelAward[]

  @@unique([enrollmentId,idempotencyKey])
  @@index([assessmentId,submittedAt])
  @@index([enrollmentId,verdict])
}

model JourneyChapterUnlock {
  id            String @id @default(cuid())
  enrollmentId  String
  chapterId     String
  reason        JourneyUnlockReason
  attemptId     String?
  grantedById   String?
  createdAt     DateTime @default(now())
  enrollment    JourneyEnrollment @relation(fields:[enrollmentId],references:[id],onDelete:Restrict)
  chapter       JourneyChapter @relation(fields:[chapterId],references:[id],onDelete:Restrict)
  attempt       JourneyTestAttempt? @relation(fields:[attemptId],references:[id],onDelete:Restrict)

  @@unique([enrollmentId,chapterId])
  @@index([chapterId])
}

model JourneyChapterCompletion {
  id            String @id @default(cuid())
  enrollmentId  String
  chapterId     String
  attemptId     String
  completedAt   DateTime @default(now())
  enrollment    JourneyEnrollment @relation(fields:[enrollmentId],references:[id],onDelete:Restrict)
  chapter       JourneyChapter @relation(fields:[chapterId],references:[id],onDelete:Restrict)
  attempt       JourneyTestAttempt @relation(fields:[attemptId],references:[id],onDelete:Restrict)

  @@unique([enrollmentId,chapterId])
  @@index([attemptId])
}

model JourneyLevelAward {
  id            String @id @default(cuid())
  enrollmentId  String
  levelId       String
  reason        JourneyUnlockReason
  attemptId     String?
  awardedAt     DateTime @default(now())
  enrollment    JourneyEnrollment @relation(fields:[enrollmentId],references:[id],onDelete:Restrict)
  level         JourneyLevelDefinition @relation(fields:[levelId],references:[id],onDelete:Restrict)
  attempt       JourneyTestAttempt? @relation(fields:[attemptId],references:[id],onDelete:Restrict)

  @@unique([enrollmentId,levelId])
  @@index([levelId])
}


// Initial self-assessment survives while the coach prepares a matching published
// pathway. It is independent of confirmed level and never grants access.
enum JourneyIntakeStatus {
  PENDING_PATHWAY
  PENDING_PLACEMENT
  CONFIRMED
}

enum JourneyDashboard {
  GENERAL
  WOMEN
}


// Opt-in interface preference. Does not store cycle entries, medical data or sex.
// Separate from JourneyIntake so legacy athletes can freely switch layouts.
model AthleteDashboardPreference {
  userId              String @id
  mode                JourneyDashboard @default(GENERAL)
  presenterPreference  String @default("ANY")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User @relation(fields:[userId],references:[id],onDelete:Cascade)
}

model JourneyIntake {
  id                String @id @default(cuid())
  userId            String @unique
  selectedGoalSlugs String[]
  selfLevel         JourneyLevel
  status            JourneyIntakeStatus @default(PENDING_PATHWAY)
  dashboard         JourneyDashboard @default(GENERAL)
  matchedVersionId  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User @relation(fields:[userId],references:[id],onDelete:Restrict)

  @@index([status,createdAt])
  @@index([matchedVersionId])
}


// Private and optional. Not connected to Journey score, levels or coach filters.
model CyclePrivacy {
 entries           CycleJournalEntry[]
 userId            String @id
 enabled           Boolean @default(false)
 consentVersion    String?
 consentedAt       DateTime?
 shareWithCoach    Boolean @default(false)
 remindersEnabled  Boolean @default(false)
 lastPeriodStart   DateTime? @db.Date
 cycleLengthDays   Int?
 updatedAt         DateTime @updatedAt
 user              User @relation(fields:[userId],references:[id],onDelete:Cascade)
}

model CycleJournalEntry {
 id           String @id @default(cuid())
 userId       String
 date         DateTime @db.Date
 flow         String? // NONE/LIGHT/MEDIUM/HEAVY only, validated in private owner endpoint
 symptoms     String[] @default([])
 energy       Int?
 mood         Int?
 discomfort   Int?
 planChoice   String @default("AS_PLANNED") // EASIER/REST are requests, not coach-approved edits
 createdAt    DateTime @default(now())
 updatedAt    DateTime @updatedAt
 privacy      CyclePrivacy @relation(fields:[userId],references:[userId],onDelete:Cascade)
 @@unique([userId,date])
 @@index([userId,date])
}
