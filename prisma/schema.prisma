generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriptionTier {
  FREE
  PRO
  ELITE
}

enum UserRole {
  ATHLETE
  COACH
  ADMIN
}

enum MessageKind {
  TEXT
  VOICE
  VIDEO
}

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  name             String?
  role             UserRole         @default(ATHLETE)
  subscriptionTier SubscriptionTier @default(FREE)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  goals            Goal[]
  workouts         Workout[]
  scoreSnapshots   ScoreSnapshot[]
  dailyChecks      DailyCheck[]
}

model Goal {
  id        String   @id @default(cuid())
  userId    String
  type      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TrainingPlan {
  id          String    @id @default(cuid())
  name        String
  description String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workouts    Workout[]
}

model Workout {
  id             String        @id @default(cuid())
  userId         String
  trainingPlanId String?
  title          String
  scheduledAt    DateTime?
  completedAt    DateTime?
  rpe            Int?
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainingPlan   TrainingPlan? @relation(fields: [trainingPlanId], references: [id])
  sets           SetLog[]
}

model Exercise {
  id          String   @id
  nameDe      String
  nameEn      String?
  category    String
  equipment   String?
  primaryMuscles String?
  secondaryMuscles String?
  level       Int      @default(1)
  coachCue1   String?
  coachCue2   String?
  coachCue3   String?
  commonMistakes Json?
  videoUrl    String?
  imageStart  String?
  imageMiddle String?
  imageEnd    String?
  trackingType String?
  freeAccess  Boolean  @default(false)
  sets        SetLog[]
}

model SetLog {
  id         String   @id @default(cuid())
  workoutId  String
  exerciseId String
  setNumber  Int
  reps       Int?
  weightKg   Float?
  durationS  Int?
  distanceM  Float?
  createdAt  DateTime @default(now())
  workout    Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
}

model DailyCheck {
  id         String   @id @default(cuid())
  userId     String
  date       DateTime @db.Date
  energy     Int?
  soreness   Int?
  mood       Int?
  stress     Int?
  sleepHours Float?
  restingHr  Float?
  hrv        Float?
  steps      Int?
  waterMl    Int?
  proteinG   Float?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model BodyMetric {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date
  weightKg  Float?
  waistCm   Float?
  chestCm   Float?
  bodyFat   Float?
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model ProgressPhoto {
  id        String   @id @default(cuid())
  userId    String
  url       String
  takenAt   DateTime
  private   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([userId, takenAt])
}

model WearableDaily {
  id             String   @id @default(cuid())
  userId         String
  date           DateTime @db.Date
  source         String
  steps          Int?
  activeCalories Float?
  totalCalories  Float?
  restingHr      Float?
  hrv            Float?
  sleepMinutes   Int?
  sleepStages    Json?
  vo2max         Float?
  workouts       Json?
  completeness   Int      @default(0)

  @@unique([userId, date, source])
}

model NutritionDaily {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime @db.Date
  calories    Float?
  proteinG    Float?
  carbsG      Float?
  fatG        Float?
  waterMl     Int?
  fruitVegServings Float?
  addedSugarG Float?
  source      String?
  fuelScore   Int?

  @@unique([userId, date])
}

model PerformanceTest {
  id          String   @id @default(cuid())
  userId      String
  name        String
  scheduledAt DateTime?
  completedAt DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  results     TestResult[]

  @@index([userId, completedAt])
}

model TestResult {
  id        String   @id @default(cuid())
  testId    String
  metric    String
  value     Float
  unit      String
  videoUrl  String?
  createdAt DateTime @default(now())
  test      PerformanceTest @relation(fields: [testId], references: [id], onDelete: Cascade)
}

model ScoreSnapshot {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime @db.Date
  total       Int
  strength    Int?
  endurance   Int?
  athleticism Int?
  mobility    Int?
  recovery    Int?
  fuel        Int?
  consistency Int?
  completeness Int @default(100)
  explanation Json?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model CoachingRule {
  id         String   @id @default(cuid())
  key        String   @unique
  title      String
  enabled    Boolean  @default(true)
  priority   Int      @default(100)
  conditions Json
  action     Json
  updatedAt  DateTime @updatedAt
}

model Recommendation {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime @db.Date
  severity    String
  title       String
  explanation String
  action      String
  sourceRule  String?
  coachStatus String     @default("PENDING")
  createdAt   DateTime   @default(now())

  @@index([userId, date])
}

model Message {
  id          String      @id @default(cuid())
  athleteId   String
  coachId     String
  senderId    String
  kind        MessageKind @default(TEXT)
  text        String?
  mediaUrl    String?
  durationSec Int?
  createdAt   DateTime    @default(now())
  readAt      DateTime?

  @@index([athleteId, createdAt])
}

model VideoFeedback {
  id          String   @id @default(cuid())
  athleteId   String
  coachId     String
  videoUrl    String
  annotations Json?
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
  reviewedAt  DateTime?

  @@index([athleteId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  category  String
  title     String
  body      String
  sendAt    DateTime?
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Subscription {
  id          String           @id @default(cuid())
  userId      String
  tier        SubscriptionTier
  provider    String
  externalId  String?
  status      String
  trialEndsAt DateTime?
  renewsAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, status])
}

model Badge {
  id          String   @id @default(cuid())
  userId      String
  key         String
  name        String
  unlockedAt  DateTime @default(now())

  @@unique([userId, key])
}

model Challenge {
  id          String   @id @default(cuid())
  title       String
  description String?
  proOnly     Boolean  @default(false)
  startsAt    DateTime
  endsAt      DateTime
  createdAt   DateTime @default(now())
}
